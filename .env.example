# Copy this file to ".env" and fill in your real values there.
# The .env file is where your secrets live - it is git-ignored and
# never gets typed into bot.py or committed to version control.

# Get this from @BotFather on Telegram after creating your bot.
TELEGRAM_BOT_TOKEN=

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides - safe to leave as-is.
# CLAUDE_MODEL=claude-opus-4-8
# SYSTEM_PROMPT=You are a helpful assistant, chatting with the user over Telegram.

# --- /build feature (Jarvis delegating coding tasks) ---

# Your numeric Telegram user id. Only this user can use /build. Message
# @userinfobot on Telegram to get yours, then paste the number here (no
# quotes). Leave blank to keep /build disabled.
JARVIS_OWNER_ID=

# Optional: where /build reads and writes files. Defaults to a "jarvis-projects"
# folder that sits next to this repo (NOT inside it), so Jarvis never edits
# its own bot code. Uncomment to override with an absolute path.
# WORKSPACE_DIR=/absolute/path/to/jarvis-projects
