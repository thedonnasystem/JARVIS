{
  "_about": "FENDEZY AI CREATIVE STUDIO template / preset library (M8c). DATA ONLY: prompt vocabulary, hook formulas, caption styles and per-office templates. Templates never choose a provider or a price: the router (hq_creative_studio.candidates + the DB gates) still decides the model, the money and the premium rules. Validated by hq_creative_presets.validate(); seeded into fz_creative.templates by migrations/20261207_creative_studio_v2.sql (scripts/creative_presets_seed.py keeps the two identical).",
  "_sources": {
    "open-higgsfield": "github.com/Anil-matcha/Open-Higgsfield-AI @ 6f726e6539b06bb2f4288f20480c116e7173a06d (MIT, Copyright (c) 2026 Open Generative AI Contributors): CAMERA_MAP, LENS_MAP, FOCAL_PERSPECTIVE, APERTURE_EFFECT, ENHANCE_TAGS, QUICK_PROMPTS and the prompt compiler order (src/lib/promptUtils.js); UGC video format names (MarketingStudio.jsx); video workflow kinds (videoWorkflows.js). Its Muapi cloud path and its 'no guardrails' stance are NOT adopted; its 'Product Review' format is renamed 'product demo' (no review framing).",
    "comfy-org/workflow_templates": "github.com/Comfy-Org/workflow_templates @ 8305a7d4008c64ed52e480d553bd5784011d7b11 (MIT): node graphs and default sampler settings of flux_schnell, video_wan2_2_5B_ti2v, video_wan2_2_14B_t2v, ltxv_text_to_video, re-expressed in ComfyUI API format under creative_studio/comfyui/.",
    "fendezy": "our own: camera moves, shot types, hooks, caption styles, office templates."
  },
  "version": "2026-11-23.1",
  "vocab": {
    "cameras": {
      "modular-8k": "modular 8K digital cinema camera",
      "full-frame-cine": "full-frame digital cinema camera",
      "70mm-film": "grand format 70mm film camera",
      "s35-digital": "Super 35 studio digital camera",
      "16mm-film": "classic 16mm film camera",
      "large-format-digital": "premium large-format digital cinema camera",
      "phone-ugc": "modern smartphone camera, handheld, natural social-video look"
    },
    "lenses": {
      "tilt": "creative tilt lens effect",
      "compact-anamorphic": "compact anamorphic lens",
      "macro": "extreme macro lens",
      "70s-prime": "1970s cinema prime lens",
      "classic-anamorphic": "classic anamorphic lens",
      "modern-prime": "premium modern prime lens",
      "warm-prime": "warm-toned cinema prime lens",
      "swirl-bokeh": "swirl bokeh portrait lens",
      "vintage-prime": "vintage prime lens",
      "halation": "halation diffusion filter",
      "sharp-prime": "ultra-sharp clinical prime lens"
    },
    "focal": {"8": "ultra-wide perspective", "14": "wide-angle perspective", "24": "wide-angle dynamic perspective", "35": "natural cinematic perspective",
              "50": "standard portrait perspective", "85": "classic portrait perspective", "100": "macro product perspective"},
    "aperture": {"f/1.4": "shallow depth of field, creamy bokeh", "f/4": "balanced depth of field", "f/11": "deep focus clarity, sharp foreground to background"},
    "lighting": {"cinematic": "cinematic lighting", "golden-hour": "golden hour", "studio": "dramatic studio lighting", "soft": "soft diffused light", "neon": "neon glow",
                 "volumetric": "volumetric rays", "softbox-product": "large softbox key light, clean specular highlights, subtle rim light", "club": "club lights, coloured haze, strobes"},
    "mood": {"moody": "moody atmosphere", "serene": "serene and peaceful", "epic": "epic and dramatic", "cozy": "warm and cozy", "mysterious": "dark and mysterious",
             "luxury": "premium, minimal, luxurious", "street": "raw street energy"},
    "quality": ["professional photography", "ultra-detailed", "high dynamic range", "natural color science"],
    "shot_types": {
      "ecu": "extreme close-up", "cu": "close-up shot", "mcu": "medium close-up", "medium": "medium shot", "wide": "wide establishing shot",
      "flat-lay": "overhead flat lay", "hero-low": "low-angle hero shot", "ots": "over-the-shoulder shot", "pov": "first-person POV shot", "three-quarter": "three-quarter product angle"
    },
    "camera_moves": {
      "static": "locked-off static camera", "push-in": "slow push-in towards the subject", "pull-out": "slow pull-out revealing the scene",
      "orbit": "smooth 180-degree orbit around the subject", "turntable": "360-degree turntable rotation of the product", "dolly-left": "lateral dolly move to the left",
      "dolly-right": "lateral dolly move to the right", "crane-up": "crane up rising over the subject", "tilt-up": "slow tilt up from the ground", "handheld": "subtle handheld movement",
      "whip-pan": "fast whip pan transition", "fpv": "FPV drone fly-through", "macro-slide": "macro slider move across surface details", "zoom-punch": "quick zoom punch-in on the beat"
    },
    "ugc_formats": {
      "ugc-talking": "AI presenter talking to camera, selfie framing",
      "tutorial": "how-to: AI presenter demonstrates the steps",
      "unboxing": "hands unbox the product on a table, close-ups of details",
      "hyper-motion": "fast dynamic product motion, speed ramps",
      "product-demo": "AI presenter demonstrates the product features, clearly labelled as AI",
      "tv-spot": "polished 15-second broadcast-style spot"
    },
    "video_workflows": ["text_to_video", "animate_image", "keyframes", "references", "edit_video", "extend_uploaded_video", "motion_transfer"]
  },
  "hooks": [
    {"id": "pov", "text": "POV: {subject}", "fits": ["ugc", "video"]},
    {"id": "stop-scroll", "text": "Stop scrolling if you {pain}", "fits": ["ugc", "video", "edit"]},
    {"id": "question", "text": "Ever wondered {question}?", "fits": ["ugc", "video", "image"]},
    {"id": "three-reasons", "text": "3 reasons {subject} is different", "fits": ["ugc", "video", "edit"]},
    {"id": "before-after", "text": "Before vs after {subject}", "fits": ["video", "edit", "image"]},
    {"id": "drop-reveal", "text": "New drop: {subject}", "fits": ["video", "ugc", "image", "edit"]},
    {"id": "countdown", "text": "{n} seconds to {outcome}", "fits": ["video", "edit"]},
    {"id": "lyric-first-line", "text": "{first_line}", "fits": ["music", "edit"]},
    {"id": "out-now", "text": "Out now: {title}", "fits": ["music", "edit", "image", "video"]},
    {"id": "meet-character", "text": "Meet {character}", "fits": ["image", "video"]}
  ],
  "caption_styles": {
    "karaoke": {"font": "DejaVu Sans", "size": 72, "bold": true, "primary": "#FFFFFF", "highlight": "#F4C430", "outline": "#000000", "outline_px": 5, "shadow_px": 2, "position": "lower", "words_per_line": 3, "uppercase": true, "animation": "word-highlight"},
    "pop": {"font": "DejaVu Sans", "size": 84, "bold": true, "primary": "#FFFFFF", "highlight": "#00E5FF", "outline": "#000000", "outline_px": 6, "shadow_px": 0, "position": "center", "words_per_line": 1, "uppercase": true, "animation": "pop-in"},
    "lyric": {"font": "DejaVu Serif", "size": 64, "bold": false, "primary": "#FFFFFF", "highlight": "#FF4FA3", "outline": "#000000", "outline_px": 3, "shadow_px": 3, "position": "center", "words_per_line": 6, "uppercase": false, "animation": "word-highlight"},
    "subtle": {"font": "DejaVu Sans", "size": 52, "bold": false, "primary": "#FFFFFF", "highlight": "#FFFFFF", "outline": "#000000", "outline_px": 3, "shadow_px": 1, "position": "lower", "words_per_line": 7, "uppercase": false, "animation": "none"}
  },
  "templates": [
    {"slug": "trap-product-hero-still", "office": "the-trap", "module": "image", "kind": "product", "title": "Product hero still (softbox, three-quarter)",
     "prompt": {"shot": "three-quarter", "camera": "large-format-digital", "lens": "sharp-prime", "focal": "100", "aperture": "f/11", "lighting": ["softbox-product"], "mood": "luxury",
                "base": "{product} on a seamless backdrop in brand colours, commercial product photography"},
     "negative": "text, watermark, extra objects, deformed product, logo distortion", "edit": {"fit": "pad"}, "hooks": ["drop-reveal"], "workflow": "flux-schnell-t2i", "source": "open-higgsfield + fendezy"},
    {"slug": "trap-flat-lay", "office": "the-trap", "module": "image", "kind": "product", "title": "Overhead flat lay",
     "prompt": {"shot": "flat-lay", "camera": "full-frame-cine", "lens": "modern-prime", "focal": "50", "aperture": "f/4", "lighting": ["soft"], "mood": "street",
                "base": "{product} styled with matching accessories on concrete, overhead flat lay"},
     "negative": "text, watermark, clutter", "edit": {"fit": "pad"}, "hooks": ["drop-reveal"], "workflow": "flux-schnell-t2i", "source": "fendezy"},
    {"slug": "trap-turntable", "office": "the-trap", "module": "video", "kind": "product", "title": "Product turntable 5 s",
     "prompt": {"shot": "three-quarter", "move": "turntable", "camera": "large-format-digital", "lens": "sharp-prime", "focal": "85", "aperture": "f/4", "lighting": ["softbox-product"], "mood": "luxury",
                "base": "{product} rotating on a turntable, clean studio"},
     "negative": "blurry, morphing product, extra limbs, text", "video": {"seconds": 5, "fps": 24}, "workflow": "wan22-ti2v-5b",
     "edit": {"fit": "auto_reframe", "hook_first": false, "loudnorm": -14, "captions": "subtle"}, "hooks": ["drop-reveal"], "source": "fendezy"},
    {"slug": "trap-unboxing-ugc", "office": "the-trap", "module": "ugc", "kind": "ugc", "title": "Unboxing (AI hands, labelled)",
     "prompt": {"ugc_format": "unboxing", "shot": "cu", "move": "handheld", "camera": "phone-ugc", "lighting": ["soft"], "base": "{product} being unboxed on a wooden table"},
     "negative": "faces of real people, brand logos of other companies, text", "video": {"seconds": 5, "fps": 24}, "workflow": "wan22-ti2v-5b",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "karaoke"}, "hooks": ["pov", "drop-reveal"], "source": "open-higgsfield (format) + fendezy"},
    {"slug": "trap-hyper-motion-edit", "office": "the-trap", "module": "edit", "kind": "edit", "title": "Hyper-motion beat cut from approved clips",
     "prompt": {"ugc_format": "hyper-motion", "base": "{product}"},
     "edit": {"fit": "auto_reframe", "beat_sync": {"beats_per_cut": 2}, "hook_first": true, "broll": true, "loudnorm": -14, "captions": "pop", "max_seconds": 15}, "hooks": ["drop-reveal", "countdown"], "source": "fendezy"},

    {"slug": "b2b-cover-art", "office": "b2b-records", "module": "image", "kind": "character", "title": "Single cover art (artist LoRA, consent required for a real artist)",
     "prompt": {"shot": "mcu", "camera": "70mm-film", "lens": "70s-prime", "focal": "50", "aperture": "f/1.4", "lighting": ["neon", "volumetric"], "mood": "moody",
                "base": "album cover portrait of {character}, {theme}, square composition, space for the title"},
     "negative": "text, letters, watermark, signature, famous artist likeness", "requires": {"character_lora": true}, "edit": {"fit": "pad"}, "hooks": ["out-now"], "workflow": "flux-schnell-lora-t2i", "source": "open-higgsfield + fendezy"},
    {"slug": "b2b-visualizer", "office": "b2b-records", "module": "music", "kind": "visualizer", "title": "Audio visualizer over the cover art",
     "prompt": {"base": "{title}"}, "edit": {"visualizer": "waves", "loudnorm": -14, "captions": "none"}, "hooks": ["out-now"], "source": "fendezy (ffmpeg showwaves / showfreqs)"},
    {"slug": "b2b-lyric-video", "office": "b2b-records", "module": "music", "kind": "lyric_video", "title": "Lyric video (word-timed by faster-whisper)",
     "prompt": {"base": "{title}"}, "edit": {"visualizer": "spectrum", "loudnorm": -14, "captions": "lyric"}, "hooks": ["lyric-first-line"], "source": "fendezy (faster-whisper word timestamps)"},
    {"slug": "b2b-beat-cut", "office": "b2b-records", "module": "edit", "kind": "edit", "title": "Beat-synced music-video cut from approved clips",
     "prompt": {"base": "{title}"}, "edit": {"fit": "auto_reframe", "beat_sync": {"beats_per_cut": 4}, "hook_first": true, "broll": true, "loudnorm": -14, "captions": "lyric", "max_seconds": 30},
     "hooks": ["lyric-first-line", "out-now"], "source": "fendezy (librosa beat tracking when installed, numpy onset tracker otherwise)"},
    {"slug": "b2b-performance-clip", "office": "b2b-records", "module": "video", "kind": "shot", "title": "Performance clip (character LoRA stills to video)",
     "prompt": {"shot": "medium", "move": "orbit", "camera": "s35-digital", "lens": "classic-anamorphic", "focal": "35", "aperture": "f/1.4", "lighting": ["club"], "mood": "epic",
                "base": "{character} performing on a small stage, crowd silhouettes"},
     "negative": "famous artist likeness, text, watermark, deformed hands", "requires": {"character_lora": true}, "video": {"seconds": 5, "fps": 16}, "workflow": "wan22-t2v-a14b",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "lyric"}, "hooks": ["out-now"], "source": "fendezy"},

    {"slug": "pimp-character-portrait", "office": "pimp-ai", "module": "image", "kind": "character", "title": "Character portrait (registered LoRA, consistent identity)",
     "prompt": {"shot": "mcu", "camera": "full-frame-cine", "lens": "swirl-bokeh", "focal": "85", "aperture": "f/1.4", "lighting": ["golden-hour"], "mood": "cozy",
                "base": "portrait of {character}, {outfit}, {location}"},
     "negative": "real celebrity likeness, minors, nudity, text, watermark", "requires": {"character_lora": true}, "edit": {"fit": "pad"}, "hooks": ["meet-character"], "workflow": "flux-schnell-lora-t2i", "source": "open-higgsfield + fendezy"},
    {"slug": "pimp-character-reel", "office": "pimp-ai", "module": "video", "kind": "character", "title": "Character reel 5 s (LoRA still to video)",
     "prompt": {"shot": "medium", "move": "push-in", "camera": "phone-ugc", "lighting": ["soft"], "base": "{character} {action}, {location}"},
     "negative": "real celebrity likeness, minors, nudity, morphing face", "requires": {"character_lora": true}, "video": {"seconds": 5, "fps": 24}, "workflow": "wan22-ti2v-5b",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "karaoke"}, "hooks": ["pov", "meet-character"], "source": "fendezy"},
    {"slug": "pimp-character-train", "office": "pimp-ai", "module": "train", "kind": "character", "title": "Character LoRA training set guide",
     "prompt": {"base": "{trigger_word}"}, "requires": {"character_lora": false, "images_min": 12}, "edit": {}, "hooks": [], "source": "fendezy (fal flux-lora-fast-training input; ai-toolkit later)"},

    {"slug": "ffm-hero-ad", "office": "ff-marketing", "module": "video", "kind": "hero_ad", "title": "Hero ad 5 s (hero tier; the router decides the model)",
     "prompt": {"shot": "hero-low", "move": "crane-up", "camera": "modular-8k", "lens": "modern-prime", "focal": "35", "aperture": "f/4", "lighting": ["cinematic", "golden-hour"], "mood": "epic",
                "base": "{subject}, aspirational lifestyle scene"},
     "negative": "text, watermark, real people likeness", "video": {"seconds": 5, "fps": 24}, "workflow": "wan22-t2v-a14b",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "karaoke"}, "hooks": ["question", "stop-scroll"], "source": "open-higgsfield (tv-spot) + fendezy"},
    {"slug": "ffm-ugc-presenter", "office": "ff-marketing", "module": "ugc", "kind": "ugc", "title": "AI presenter explainer (labelled AI)",
     "prompt": {"ugc_format": "ugc-talking", "shot": "mcu", "move": "handheld", "camera": "phone-ugc", "lighting": ["soft"], "base": "friendly AI presenter explaining {subject} in a bright home office"},
     "negative": "real person likeness, text", "video": {"seconds": 5, "fps": 24}, "workflow": "ltxv-t2v",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "karaoke"}, "hooks": ["question", "three-reasons", "stop-scroll"], "source": "open-higgsfield (format) + fendezy"},
    {"slug": "ffm-ad-still", "office": "ff-marketing", "module": "image", "kind": "shot", "title": "Ad still (variation generator)",
     "prompt": {"shot": "medium", "camera": "full-frame-cine", "lens": "warm-prime", "focal": "50", "aperture": "f/4", "lighting": ["golden-hour"], "mood": "cozy", "base": "{subject}"},
     "negative": "text, watermark, real people likeness", "edit": {"fit": "pad"}, "hooks": ["question"], "workflow": "flux-schnell-t2i", "source": "open-higgsfield"},
    {"slug": "ffm-broll-stitch", "office": "ff-marketing", "module": "edit", "kind": "edit", "title": "B-roll stitch with hook first and burned captions",
     "prompt": {"base": "{subject}"}, "edit": {"fit": "auto_reframe", "hook_first": true, "broll": true, "loudnorm": -14, "captions": "karaoke", "max_seconds": 20, "crossfade": 0.25},
     "hooks": ["stop-scroll", "three-reasons", "before-after"], "source": "fendezy"},

    {"slug": "group-quick-product", "office": "group", "module": "image", "kind": "product", "title": "Quick product shot (any office)",
     "prompt": {"base": "{subject}, commercial product photography, clean white background, studio lighting"}, "edit": {"fit": "pad"}, "hooks": [], "workflow": "flux-schnell-t2i", "source": "open-higgsfield QUICK_PROMPTS.Product"},
    {"slug": "group-quick-portrait", "office": "group", "module": "image", "kind": "shot", "title": "Quick portrait (fictional person, any office)",
     "prompt": {"base": "professional portrait photograph of a fictional person, shallow depth of field, soft studio lighting, 85mm lens"}, "negative": "real person likeness", "edit": {"fit": "pad"}, "hooks": [], "workflow": "flux-schnell-t2i", "source": "open-higgsfield QUICK_PROMPTS.Portrait"},
    {"slug": "group-short-explainer", "office": "group", "module": "video", "kind": "shot", "title": "Short explainer clip (any office)",
     "prompt": {"shot": "medium", "move": "push-in", "lighting": ["soft"], "base": "{subject}"}, "video": {"seconds": 5, "fps": 24}, "workflow": "ltxv-t2v",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "karaoke"}, "hooks": ["question", "pov"], "source": "fendezy"},
    {"slug": "donna-service-explainer", "office": "donna", "module": "video", "kind": "shot", "title": "Donna service explainer (AI receptionist demo, labelled)",
     "prompt": {"shot": "medium", "move": "dolly-right", "camera": "full-frame-cine", "lighting": ["soft"], "mood": "serene", "base": "modern small business front desk, phone ringing, calm atmosphere, {subject}"},
     "negative": "real person likeness, text", "video": {"seconds": 5, "fps": 24}, "workflow": "ltxv-t2v",
     "edit": {"fit": "auto_reframe", "hook_first": true, "loudnorm": -14, "captions": "karaoke"}, "hooks": ["question", "stop-scroll"], "source": "fendezy"}
  ]
}
