{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/proposals/receptionist_deploy/Dockerfile",
    "watchPatterns": ["hq_receptionist.py", "receptionist_server.py", "receptionist_voice.py", "requirements-receptionist.txt", "receptionist/**", "ops/proposals/receptionist_deploy/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "sleepApplication": false
  }
}
