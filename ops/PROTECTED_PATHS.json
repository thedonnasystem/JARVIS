  "owner_identity_note": "owner_login must be a GitHub account that NO agent session can use. Today the agents and the owner share the account in agent_logins, so the gate FAILS CLOSED (no approval can count) until the Chairman creates a second GitHub account, puts its login here and in .github/CODEOWNERS, and removes nothing else. Owner decision.",
  "trusted": {
    "about": "CI runs scripts/check_protected_paths.py and this file from the PR's BASE branch. ONLY the pull_request_target job protected-paths (protected-paths.yml) is relied on: it runs no PR code. The copy inside tests.yml's unit job runs after the PR's own tests in the same job, so a PR can switch it off (S6): it is an early warning, never the control.",
    "protected_branches": [
      "overnight-build",
      "main",
      "master",
      "claude/telegram-claude-bot-59nusk",
      "jarvis/integration"
    ]
  },
  "self_edit": {
    "mode_file": "ops/SELF_EDIT_MODE",
    "modes": [
      "allowlist",
      "denylist"
    ],
    "default_mode": "allowlist",
    "branch_prefix": "jarvis/auto-",
    "about": "allowlist: Jarvis's self-edits may auto-ship ONLY inside auto_ship_zone (docs/** and prompts/**: text, nothing that runs). webapp/hq/** (runs in the Chairman's signed-in app) and jarvis_skills/** were removed from the zone (Nov 17 2026) and now need owner approval, until skills run in an isolated subprocess with an empty environment and no access to app modules and the web zone cannot reach owner functions. The zone is enforced on EVERY pull request whose head or base branch starts with a zone_branch_prefixes entry (the auto-* PRs AND the jarvis/integration release PR). denylist: anything not protected may auto-ship. The deny rules apply in both modes.",
    "auto_ship_zone": [
      "docs/**",
      "prompts/**"
    ],
    "zone_branch_prefixes": [
      "jarvis/"
    ]
  },
  "data_extensions": [
    ".md",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".pdf",
    ".woff",
    ".woff2"
  ],
  "data_names": [
    ".gitignore",
    ".dockerignore",
    "LICENSE",
    "CODEOWNERS"
  ],
  "write_patterns": {
    "about": "B3: writes that are protected whatever file they are in: the dormancy control agents.status, and REST writes whose table name is built at run time (the object cannot be read from the diff)",
    "agents_status": [
      "\\b(public\\.)?agents\\b[^\\n]{0,120}\\bstatus\\b",
      "/rest/v1/agents\\b[^\\n]{0,160}\\bstatus\\b"
    ],
    "rest_dynamic": [
      "/rest/v1/\\s*['\"]\\s*(\\+|%|\\.format\\b|\\.join\\b)",
      "/rest/v1/\\{",
      "/rest/v1/%s",
      "/rest/v1/['\"]?\\s*\\)?\\s*\\+",
      "\\.table\\s*\\(\\s*(?!['\"])[A-Za-z_]",
      "\\.from_\\s*\\(\\s*(?!['\"])[A-Za-z_]"
    ]
  }
}
