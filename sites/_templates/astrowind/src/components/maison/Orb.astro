---
// Maison hero scene: a liquid-metal orb (black chrome with molten metal veins, wine reflections, a tilted hairline ring and metal dust) drawn by
// one fragment shader in raw WebGL (no library, ~4 KB). The light follows the cursor; the surface "speaks" when the call demo plays.
// The CSS sphere in .m-orb-fallback shows first (and stays without JS / WebGL). Under prefers-reduced-motion one still frame is drawn.
// Starts after the page has loaded and is idle; pauses off-screen and in background tabs; resolution is capped for battery and speed.
// Without a GPU (software WebGL, e.g. headless test browsers) the CSS sphere stays; on a slow GPU it lowers resolution, then stops.
const { label = '' } = Astro.props;
---

<canvas class="m-orb-canvas" aria-hidden="true" data-m-orb></canvas>
<div class="m-orb-anchor" role="img" aria-label={label} data-m-orb-anchor>
  <div class="m-orb-fallback"></div>
</div>

<script>
  const VERT = `attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}`;
  const FRAG = `precision highp float;
uniform vec2 uRes;uniform vec3 uOrb;uniform float uTime;uniform vec2 uMouse;uniform vec3 uGold;uniform vec3 uWine;uniform float uAmp;uniform float uPx;
float h(vec3 p){p=fract(p*.3183099+.1);p*=17.;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}
float n3(vec3 x){vec3 i=floor(x),f=fract(x);f=f*f*(3.-2.*f);
return mix(mix(mix(h(i),h(i+vec3(1,0,0)),f.x),mix(h(i+vec3(0,1,0)),h(i+vec3(1,1,0)),f.x),f.y),
mix(mix(h(i+vec3(0,0,1)),h(i+vec3(1,0,1)),f.x),mix(h(i+vec3(0,1,1)),h(i+vec3(1,1,1)),f.x),f.y),f.z);}
float fbm(vec3 p){float a=.5,s=0.;for(int i=0;i<3;i++){s+=a*n3(p);p=p*2.03+vec3(1.7,9.2,3.1);a*=.5;}return s;}
vec3 env(vec3 d,float t){
 vec3 W=vec3(1.,.94,.82);float y=d.y;
 vec3 c=vec3(.01,.006,.008)+uWine*.3*smoothstep(-.05,.95,y)+uWine*.12*smoothstep(.05,-.9,y);
 float hz=y-.04-.05*sin(d.x*2.3+t*.21);
 c+=mix(uGold,W,.35)*exp(-abs(hz)*34.)*.95+uGold*.22*exp(-abs(hz)*6.);
 float s1=smoothstep(.11,.03,abs(d.x-.42-.06*sin(t*.13)))*smoothstep(.0,.25,y)*smoothstep(.98,.7,y);
 float s2=smoothstep(.05,.015,abs(d.x+.58))*smoothstep(.1,.35,y)*smoothstep(.92,.6,y);
 c+=W*(s1*1.15+s2*.55)*step(-.2,d.z);
 c+=uGold*.75*exp(-abs(y+.42+.07*sin(d.x*3.1-t*.17))*12.)+uGold*.12*smoothstep(-.2,-.95,y);
 vec3 L=normalize(vec3(uMouse.x*.85,.32+uMouse.y*.5,.75));float k=max(dot(d,L),0.);
 c+=W*pow(k,160.)*3.2+uGold*pow(k,14.)*.3;
 c+=uWine*1.5*pow(max(dot(d,normalize(vec3(-.75,-.15,-.6))),0.),3.)*.7;
 return c;}
void main(){
 vec2 fc=gl_FragCoord.xy;float R=uOrb.z;vec2 q=(fc-uOrb.xy)/R;float t=uTime;
 float r=length(q);float ang=atan(q.y,q.x);
 float wob=1.+.010*(1.+2.5*uAmp)*sin(ang*3.+t*.8)+.006*sin(ang*5.-t*1.2);
 float rr=r/wob;float aa=uPx/R*1.5;
 float disc=1.-smoothstep(1.-aa,1.,rr);
 vec3 col=vec3(0.);float al=0.;
 if(rr<1.){
  vec3 n=vec3(q/wob,sqrt(max(0.,1.-rr*rr)));
  vec3 s=n*1.25+vec3(0.,t*.05,t*.09);
  vec3 w=vec3(fbm(s),fbm(s+vec3(5.2,1.3,2.8)),fbm(s+vec3(1.7,9.2,4.1)))-.5;
  vec3 nn=normalize(n+w*(.75+.55*uAmp));
  vec3 rf=reflect(vec3(0.,0.,-1.),nn);
  vec3 e=env(rf,t);
  float m=fbm(s*1.1+w*1.6+vec3(0.,0.,t*.03));
  float g=smoothstep(.36,.66,m);
  vec3 tint=mix(vec3(.78,.62,.64),uGold*1.75,g);
  col=e*tint+uGold*.035*g;
  float fr=pow(1.-max(nn.z,0.),4.);
  col+=uGold*fr*.32+uWine*fr*.3;
  col=1.-exp(-col*1.25);
  col*=.82+.18*nn.z;
  al=disc;col*=disc;}
 float halo=exp(-max(r-1.,0.)*3.2)*(1.-disc);
 col+=(uWine*.55+uGold*.05)*halo*.55;al=max(al,halo*.45);
 float ca=cos(-.38),sa=sin(-.38);vec2 p=mat2(ca,-sa,sa,ca)*q;float S=3.4;
 for(int i=0;i<2;i++){float k=i==0?1.42:1.68;float e2=length(vec2(p.x,p.y*S));
  vec2 g=vec2(p.x,S*S*p.y)/max(e2,1e-4);float dpx=abs(e2-k)/max(length(g),1e-4)*R;
  float line=(1.-smoothstep(.4,1.4,dpx/max(uPx,1.)))*(i==0?.85:.35);
  float behind=step(0.,p.y)*disc;line*=1.-behind;
  float a2=atan(p.y*S,p.x);float spark=pow(.5+.5*cos(a2-t*.5-float(i)*2.),24.);
  vec3 lc=uGold*(.55+1.6*spark);col+=lc*line;al=max(al,line*(.6+.4*spark));}
 vec2 cell=floor(fc/(46.*uPx));vec2 cf=fract(fc/(46.*uPx));float hh=h(vec3(cell,7.));
 if(hh>.86){vec2 pp=vec2(h(vec3(cell,1.)),h(vec3(cell,2.)));float tw=.5+.5*sin(t*(.6+hh)+hh*40.);
  float d=length((cf-pp)*46.)/1.1;float dust=(1.-smoothstep(.2,1.,d))*tw*.7;col+=uGold*dust;al=max(al,dust);}
 gl_FragColor=vec4(col,clamp(al,0.,1.));}`;

  const cv = document.querySelector<HTMLCanvasElement>('[data-m-orb]');
  const anchor = document.querySelector<HTMLElement>('[data-m-orb-anchor]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hex = (v: string, d: number[]) => {
    const m = /^#?([0-9a-f]{6})$/i.exec(v.trim());
    if (!m) return d;
    const n = parseInt(m[1], 16);
    return [(n >> 16) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  };

  function start() {
    if (!cv || !anchor) return;
    const gl = cv.getContext('webgl', { premultipliedAlpha: true, antialias: false, alpha: true, powerPreference: 'low-power' });
    if (!gl) return;
    const dbg = gl.getExtension('WEBGL_debug_renderer_info');
    const renderer = String(dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER));
    // No GPU: keep the CSS sphere (a software-rendered shader would cost the main thread seconds). ?fx=full forces it, for previews.
    if (/swiftshader|llvmpipe|softpipe|software|basic render/i.test(renderer) && !/[?&]fx=full\b/.test(location.search)) return;
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const pr = gl.createProgram()!;
    gl.attachShader(pr, vs);
    gl.attachShader(pr, fs);
    gl.linkProgram(pr);
    if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return;
    gl.useProgram(pr);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const U = (n: string) => gl.getUniformLocation(pr, n);
    const uRes = U('uRes'), uOrb = U('uOrb'), uTime = U('uTime'), uMouse = U('uMouse'), uAmp = U('uAmp'), uPx = U('uPx');
    const css = getComputedStyle(document.documentElement);
    gl.uniform3fv(U('uGold'), hex(css.getPropertyValue('--fx-accent'), [0.79, 0.64, 0.29]));
    gl.uniform3fv(U('uWine'), hex(css.getPropertyValue('--fx-primary'), [0.48, 0.08, 0.16]));

    let scale = 1, W = 0, H = 0, budget = 1400000;
    const size = () => {
      const r = cv.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      scale = Math.min(dpr, Math.sqrt(budget / Math.max(1, r.width * r.height)));
      W = Math.max(1, Math.round(r.width * scale));
      H = Math.max(1, Math.round(r.height * scale));
      cv.width = W;
      cv.height = H;
      gl.viewport(0, 0, W, H);
      gl.uniform2f(uRes, W, H);
      gl.uniform1f(uPx, scale);
    };
    size();
    window.addEventListener('resize', size);

    const mouse = { x: 0.25, y: 0.35, tx: 0.25, ty: 0.35 };
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (fine) window.addEventListener('pointermove', (e) => { mouse.tx = (e.clientX / innerWidth) * 2 - 1; mouse.ty = -((e.clientY / innerHeight) * 2 - 1); }, { passive: true });
    let amp = 0, ampT = 0;
    window.addEventListener('m:voice', (e) => { ampT = (e as CustomEvent).detail || 0; });

    let visible = true, t0 = performance.now(), last = t0, time = 9.0;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(cv);

    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      time += dt;
      if (!fine) { mouse.tx = Math.sin(time * 0.23) * 0.7; mouse.ty = 0.3 + Math.cos(time * 0.17) * 0.4; }
      mouse.x += (mouse.tx - mouse.x) * 0.04;
      mouse.y += (mouse.ty - mouse.y) * 0.04;
      amp += (ampT * (0.6 + 0.4 * Math.sin(time * 9.0) * Math.sin(time * 3.1)) - amp) * 0.08;
      const cr = cv.getBoundingClientRect(), ar = anchor.getBoundingClientRect();
      const R = (ar.width / 2) * scale;
      const cx = (ar.left - cr.left + ar.width / 2) * scale + mouse.x * R * 0.03;
      const cy = H - (ar.top - cr.top + ar.height / 2) * scale + mouse.y * R * 0.03;
      gl.uniform3f(uOrb, cx, cy, R);
      gl.uniform1f(uTime, time);
      gl.uniform2f(uMouse, mouse.x, mouse.y);
      gl.uniform1f(uAmp, amp);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    frame(t0);
    cv.classList.add('is-on');
    anchor.classList.add('is-gl');
    if (reduce) {
      window.addEventListener('resize', () => frame(performance.now()));
      return;
    }
    let slow = 0, n = 0, stopped = false;
    const loop = (now: number) => {
      if (visible && !document.hidden) {
        const dt = now - last;
        frame(now);
        if (++n > 20 && n < 400) {
          slow = dt > 45 ? slow + 1 : Math.max(0, slow - 1);
          if (slow > 24) {
            slow = 0;
            if (budget > 400000) { budget /= 3; size(); } else stopped = true;
          }
        }
      } else last = now;
      if (!stopped) requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  const idle = (fn: () => void) => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(fn, { timeout: 2500 }) : setTimeout(fn, 600));
  if (document.readyState === 'complete') idle(start);
  else window.addEventListener('load', () => idle(start), { once: true });
</script>
