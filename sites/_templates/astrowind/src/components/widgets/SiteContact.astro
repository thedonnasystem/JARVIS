---
// Web Studio contact form (every site): a same-site Netlify form (no third-party endpoint, no secret in the page) with a honeypot, the CASL
// inquiry notice and an optional, unticked marketing box shown verbatim from site.json's consent block, and the wording version recorded.
// Jarvis imports submissions into the leads CRM (hq_site_inbox.py) with that version and the wording's hash.
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ContactForm from '~/components/widgets/ContactForm.astro';
import { SITE_DATA } from '~/data/site';

const c = SITE_DATA.contact || {};
const field = 'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
---

<WidgetWrapper id="contact" containerClass="max-w-7xl mx-auto">
  <Headline title={c.title} subtitle={c.subtitle} />
  <div class="flex flex-col max-w-xl mx-auto w-full">
    <ContactForm class="rounded-2xl border border-gray-200 dark:border-gray-700 shadow p-4 sm:p-6 lg:p-8" field={field} />
  </div>
</WidgetWrapper>
