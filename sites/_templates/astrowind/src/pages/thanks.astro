---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { BRAND } from '~/data/site';
const metadata = { title: `Thank you | ${BRAND}`, ignoreTitleTemplate: true, robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <HeroText title="Thank you" subtitle="We received your message and will get back to you soon." callToAction={{ text: 'Back to the home page', href: '/' }} />
</Layout>
