# Copy to $FENDEZY_SECRETS_DIR/worker.env (outside the repo, chmod 600). Placeholder names only.
# API_KEY here is the PER-AGENT worker token minted for AGENT_ID=pilot-worker-1, NOT the operator key.
API_KEY=aseph_REPLACE_per_agent_worker_token   # must start with aseph_: the worker entrypoint and worker-gate both refuse anything else (e.g. the operator key)
# Dedicated key with a PROVIDER-SIDE hard monthly cap set by the owner. Not CLAUDE_CODE_OAUTH_TOKEN (no hard cap).
ANTHROPIC_API_KEY=REPLACE_dedicated_capped_key
