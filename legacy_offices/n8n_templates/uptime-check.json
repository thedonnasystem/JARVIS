{
 "id": "uptime-check",
 "title": "Daily website check -> Telegram if down",
 "description": "Once a day, GET a URL; if it does not answer 200, alert the owner on Telegram.",
 "keywords": [
  "uptime",
  "website",
  "site down",
  "is down",
  "down",
  "monitor",
  "health check"
 ],
 "params": {
  "name": {
   "required": true,
   "desc": "workflow name"
  },
  "url": {
   "required": true,
   "desc": "https URL to check",
   "pattern": "^https:\\/\\/[^\\s<>{}]+$"
  },
  "hour": {
   "required": false,
   "default": "8",
   "desc": "hour of day (0-23, n8n timezone)",
   "pattern": "^([0-9]|1[0-9]|2[0-3])$"
  },
  "chat_id": {
   "required": true,
   "desc": "the owner's Telegram chat id",
   "pattern": "^-?[0-9]{5,16}$"
  }
 },
 "workflow": {
  "name": "<<name>>",
  "settings": {
   "executionOrder": "v1"
  },
  "nodes": [
   {
    "name": "Schedule",
    "type": "n8n-nodes-base.scheduleTrigger",
    "typeVersion": 1.2,
    "position": [
     0,
     0
    ],
    "parameters": {
     "rule": {
      "interval": [
       {
        "field": "days",
        "triggerAtHour": "<<hour>>"
       }
      ]
     }
    }
   },
   {
    "name": "Check",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.2,
    "position": [
     240,
     0
    ],
    "parameters": {
     "url": "<<url>>",
     "options": {
      "response": {
       "response": {
        "fullResponse": true,
        "neverError": true
       }
      },
      "timeout": 20000
     }
    }
   },
   {
    "name": "Down?",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2,
    "position": [
     480,
     0
    ],
    "parameters": {
     "conditions": {
      "options": {
       "caseSensitive": true,
       "typeValidation": "loose"
      },
      "combinator": "and",
      "conditions": [
       {
        "leftValue": "={{ $json.statusCode }}",
        "rightValue": 200,
        "operator": {
         "type": "number",
         "operation": "notEquals"
        }
       }
      ]
     }
    }
   },
   {
    "name": "Alert",
    "type": "n8n-nodes-base.telegram",
    "typeVersion": 1.2,
    "position": [
     720,
     0
    ],
    "parameters": {
     "chatId": "<<chat_id>>",
     "text": "=Site check failed: <<url>> answered {{ $json.statusCode }}",
     "additionalFields": {}
    }
   }
  ],
  "connections": {
   "Schedule": {
    "main": [
     [
      {
       "node": "Check",
       "type": "main",
       "index": 0
      }
     ]
    ]
   },
   "Check": {
    "main": [
     [
      {
       "node": "Down?",
       "type": "main",
       "index": 0
      }
     ]
    ]
   },
   "Down?": {
    "main": [
     [
      {
       "node": "Alert",
       "type": "main",
       "index": 0
      }
     ],
     []
    ]
   }
  }
 }
}
